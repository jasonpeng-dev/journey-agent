# Local development defaults. Docker Compose uses its own persistent SQLite path
# inside the journey-data volume; keep this relative path for a direct local run.
APP_ENV=development
DATABASE_URL=sqlite+pysqlite:///./journey_dev.db

# Safe default: no API key or network model is needed for mock mode.
MODEL_PROVIDER=mock

# Optional OpenAI-compatible provider settings. Uncomment and set these only
# when MODEL_PROVIDER=openai_compatible. Keep real keys only in local .env.
# MODEL_BASE_URL=https://api.openai.com/v1
# PLANNING_REASONING: INITIAL / REPAIR / REPLAN.
# MODEL_NAME=gpt-4.1-mini
# MODEL_API_KEY=<your-local-api-key>
# MODEL_THINKING_MODE=enabled
# MODEL_REASONING_EFFORT=high
# MODEL_TIMEOUT_SECONDS=120
# MODEL_TOTAL_TIMEOUT_SECONDS=300
# MODEL_MAX_OUTPUT_TOKENS=32768

# FAST_SEMANTIC: Dynamic Goal Entity Grounding / Interpretation. If omitted,
# this profile falls back to MODEL_NAME. Semantic thinking is always disabled
# by code; there is no semantic-thinking environment switch.
# SEMANTIC_MODEL=gpt-4.1-mini
# Goal resolution telemetry is NORMAL by default; use DEBUG only for local,
# safe public request/response diagnostics.
# GOAL_RESOLUTION_OBSERVABILITY=NORMAL

# DeepSeek example: keep the provider settings above and replace only the
# endpoint and model with values supported by your account:
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-v4-flash

# Optional server-side credential for the embedded Developer View.
DEVELOPER_API_TOKEN=
