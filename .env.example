# .env is optional. Without it, built-in defaults use Mock and
# ./journey_dev.db. To configure a provider or override defaults, copy exactly
# one complete profile into .env. Do not concatenate profiles.
# The MOCK block mirrors built-in Mock defaults; its model fields are inert
# while Mock is active and may be copied explicitly.

# ============================================================
# MOCK
# ============================================================
APP_NAME=Journey Agent Backend
APP_ENV=development
DATABASE_URL=sqlite+pysqlite:///./journey_dev.db
MODEL_PROVIDER=mock
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
SEMANTIC_MODEL=
MODEL_NAME=gpt-5.6-terra
MODEL_MAX_OUTPUT_TOKENS=8192
GOAL_RESOLUTION_TIMEOUT_SECONDS=20
PLAN_TIMEOUT_SECONDS=300
PLAN_TOTAL_TIMEOUT_SECONDS=unlimited
MODEL_MAX_REPAIR_ATTEMPTS_PER_CYCLE=2
GOAL_RESOLUTION_OBSERVABILITY=NORMAL
DEVELOPER_API_TOKEN=

# ============================================================
# OPENAI
# ============================================================
APP_NAME=Journey Agent Backend
APP_ENV=development
DATABASE_URL=sqlite+pysqlite:///./journey_dev.db
MODEL_PROVIDER=openai
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
SEMANTIC_MODEL=gpt-5.6-luna
MODEL_NAME=gpt-5.6-terra
MODEL_MAX_OUTPUT_TOKENS=8192
GOAL_RESOLUTION_TIMEOUT_SECONDS=20
PLAN_TIMEOUT_SECONDS=300
PLAN_TOTAL_TIMEOUT_SECONDS=unlimited
MODEL_MAX_REPAIR_ATTEMPTS_PER_CYCLE=2
GOAL_RESOLUTION_OBSERVABILITY=NORMAL
DEVELOPER_API_TOKEN=
