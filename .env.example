APP_ENV=development
DATABASE_URL=sqlite+pysqlite:///./journey_dev.db
MODEL_PROVIDER=mock
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
MODEL_API_KEY=
DEVELOPER_API_TOKEN=
# DeepSeek example (set these at runtime, never commit a real key):
# MODEL_PROVIDER=openai_compatible
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-v4-flash
# MODEL_TIMEOUT_SECONDS=60
MODEL_TIMEOUT_SECONDS=20
AGENT_MAX_ROUNDS=5
AGENT_MAX_TOOL_CALLS=8
PLANNER_MAX_STEPS=10
PLANNER_MAX_WAIT_STEPS=4
PLANNER_MAX_REPLANS=2
PLANNER_MAX_GENERATION_ATTEMPTS=2
